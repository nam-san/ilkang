# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# sqlite db (로컬)
*.db
*.db-journal
/prisma/*.db

# persistent volume (배포)
/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploads (근무일지 사진 - 로컬 저장)
/public/uploads/*
!/public/uploads/.gitkeep
